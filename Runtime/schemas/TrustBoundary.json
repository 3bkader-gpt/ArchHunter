{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrustBoundary",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "source_zone": { "type": "string" },
    "target_zone": { "type": "string" },
    "validation_mechanisms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["id", "source_zone", "target_zone"]
}
